### Base url -> http://localhost:4004/partner

###Get call check

####Pattern 1 — Deep expand: all 3 levels at once

GET http://localhost:4004/partner/Partner?$expand=PartnerTypes($expand=Dimensions)
Content-Type: application/json
x-csrf-token: fetch
Accept: application/json

####Pattern 2 — Single partner with full tree

GET http://localhost:4004/partner/Partner(10000000-0000-0000-0000-000000000002)?$expand=PartnerTypes($expand=Dimensions)
Content-Type: application/json
x-csrf-token: fetch
Accept: application/json

# GET http://localhost:4004/partner/Partner?$filter?$expand=PartnerTypes($expand=Dimensions)
# Content-Type: application/json
# x-csrf-token: fetch
# Accept: application/json

####Pattern 3 — Navigate: memberships of one partner


GET http://localhost:4004/partner/Partner(10000000-0000-0000-0000-000000000002)/PartnerTypes
Content-Type: application/json
x-csrf-token: fetch
Accept: application/json

####Pattern 4 — Navigate: dimensions of one membership

GET http://localhost:4004/partner/PartnerTypes(20000000-0000-0000-0000-000000000003)/Dimensions
Content-Type: application/json
x-csrf-token: fetch
Accept: application/json


###############################################################################################
######  POST CALLS #############################

### ============================================================
###  SECTION 3 – CREATE PARTNERS
###  UUID     : auto-generated by cuid aspect (never send ID)
###  Partner_Id : auto-generated by before('CREATE') handler
###               from NumberRanges table (NR_Object = 'PARTNER')
###               DO NOT send Partner_Id in the request body
###  Partner_status : defaults to E0001 (Prospective) in handler;
###                   recalculated automatically when a Membership
###                   reaches PT_Status = E0005 (Operational)
### ============================================================

POST http://localhost:4004/partner/Partner
content
Content-Type: application/json
Accept: application/json

{
  "Name_org"      : "Test partner3", 
  "Country"       : "DE",
  "Partner_level" : "GOLD"
}

###Partner type/membership creation under partner
#uuid of the partner

POST http://localhost:4004/partner/PartnerTypes
Content-Type: application/json
Accept: application/json

{
  "Partner_ID"      : "198a762e-0881-4963-99bd-f4eb02a5ee70", 
  "Valid_from"      : "2025-01-01",
  "valid_to"        : "9999-12-31",
  "Partner_Type"    : "YVAR",
  "PT_Status"       : "E0004",
  "PT_Status_Reason": ""
}